# RBS ships signatures for Gem::Version and the Gem errors, but not for
# Gem::Specification, which the gem loads at boot to read its own name and
# version.
#
# `load` is declared non-nilable even though RubyGems returns nil for a missing
# or unparsable gemspec: the gem cannot boot without one, so treating that as a
# type error at every use site would add nil guards to code that would already
# have crashed.
module Gem
  class Specification
    def self.load: (String file) -> Specification

    def name: () -> String

    def version: () -> Gem::Version
  end
end
