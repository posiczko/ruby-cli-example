module Example
  # Mixin giving including classes a level-aware stdlib Logger. Every including
  # class supplies the `@config` this reads.
  module Loggable
    @config: untyped

    self.@logger: Logger?

    # Memoized per level: a later `--debug` invocation rebuilds the logger
    # rather than reusing one pinned to the first caller's level.
    def self.logger: (untyped config) -> Logger

    def self.logger=: (Logger? value) -> Logger?

    # Returns the formatter proc Logger#formatter= expects.
    def self.formatter: (Integer level) -> untyped

    def logger: () -> Logger
  end
end
